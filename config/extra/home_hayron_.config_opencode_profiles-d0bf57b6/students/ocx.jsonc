{
  "$schema": "https://ocx.kdco.dev/schemas/profile.json",
  "registries": {},
  "renameWindow": true,

  "include": [
    "By Student/**",
    ".config/opencode/profiles/students/**",
    ".config/opencode/agents/**",
    "Documents/**"
  ],

  "exclude": [
    "**/.env",
    "**/.env.*",
    "**/ocx.jsonc",

    ".config/opencode/profiles/ws/**",
    ".config/opencode/profiles/default/**",
    ".config/opencode/profiles/gitenglish/**",

    ".opencode/**",

    "**/CLAUDE.md",
    "**/CONTEXT.md",
    "**/.claude/**",

    "**/.git/**",
    "**/node_modules/**",
    "**/.ssh/**",
    "**/.gnupg/**"
  ]
}
