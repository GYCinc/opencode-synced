{
  "agent": {
    "openagent": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.8,
      "steps": 50,
      "color": "#00BFA5",
      "permission": {
        "bash": {
          "*": "ask",
          "rm -rf /*": "deny",
          "run0 *": "allow",
        },
        "edit": {
          "**/*.env*": "deny",
          "**/*.key": "deny",
          "**/.secrets*": "deny",
          "**/railway.toml": "deny",
